# ============================================================
# Legal Procedural Intelligence — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# -----------------------------------------------------------------
# React Frontend → Node.js Express backend URL
# The React app calls this URL for all API requests.
# -----------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------
# (For reference only — NOT used by React directly)
# Node.js Express backend → Python FastAPI ML service URL
# Configure this in your Node.js backend's .env file.
# -----------------------------------------------------------------
# FASTAPI_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------
# App settings
# -----------------------------------------------------------------
VITE_APP_NAME=Legal Procedural Intelligence
VITE_APP_VERSION=1.0.0

# -----------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------
# Set to "true" to use mock data when backend is unavailable
VITE_USE_MOCK_FALLBACK=true
